# Copy to .env. Absolute Windows path to the Minecraft save the legacy (1.8.8)
# server mounts, written with FORWARD slashes - Docker Desktop rejects backslashes
# in compose bind mounts. Always point this at a COPY of your save, never the original.
MC_WORLD_PATH=C:/Users/zyypj/AppData/Roaming/.minecraft/saves/void-bedwars-working
